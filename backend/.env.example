# Servidor
PORT=3000
CORS_ORIGIN=http://localhost:5500

# Base de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lundoiafull

# JWT
JWT_ACCESS_SECRET=troca-isto-por-uma-string-aleatoria-longa
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Login com Google (Google Cloud Console → Credentials → OAuth Client ID)
GOOGLE_CLIENT_ID=

# Envio de email (Gmail SMTP com "App Password", não a password normal da conta)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="LundoIA <no-reply@lundoia.ao>"

# Chat com IA (Google Gemini — https://aistudio.google.com/apikey, tem nível gratuito)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Lembretes de estudo diários por email (hora do servidor, 0-23)
REMINDER_HOUR=18

# URL onde o entrar.html/index.html ficam acessíveis a sério — usado para
# montar links nos emails (ex: recuperação de palavra-passe).
# IMPORTANTE: tem de ser o endereço onde "http://<isto>/entrar.html" abre
# mesmo a página — não o endereço da pasta de cima. Se correres
# "npx serve" a partir da pasta que contém frontend/ e backend/ juntas
# (em vez de a partir de dentro de frontend/), o certo é:
#   FRONTEND_URL=http://localhost:5500/frontend
FRONTEND_URL=http://localhost:5500
